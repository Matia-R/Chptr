{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chptr-collab",
  "main": "party/document.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "Main", "class_name": "DocumentParty" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DocumentParty"] }],
}
